FROM oven/bun:1@sha256:0733e50325078969732ebe3b15ce4c4be5082f18c4ac1a0f0ca4839c2e4e42a7 AS builder

ARG THEME
ARG APP_VERSION
ARG VCS_REF
WORKDIR /build/web

RUN test -n "$APP_VERSION" \
    && case "$APP_VERSION" in *[!A-Za-z0-9._+-]*) exit 1 ;; esac \
    && { test "$THEME" = default || test "$THEME" = classic; } \
    && case "$VCS_REF" in *[!0-9A-Fa-f]* | '') exit 1 ;; esac \
    && test "${#VCS_REF}" -eq 40
COPY web/package.json web/bun.lock ./
COPY web/default/package.json ./default/package.json
COPY web/classic/package.json ./classic/package.json
RUN --mount=type=cache,target=/root/.bun/install/cache \
    if [ "$THEME" = classic ]; then \
        bun install --filter ./classic --frozen-lockfile; \
    else \
        bun install --frozen-lockfile; \
    fi
COPY web/default ./default
COPY web/classic ./classic
RUN cd "$THEME" \
    && DISABLE_ESLINT_PLUGIN='true' VITE_REACT_APP_VERSION="$APP_VERSION" bun run build
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /artifact/licenses/
COPY --chmod=0555 deploy/split/scripts/generate-artifact-integrity.sh /usr/local/bin/generate-artifact-integrity
RUN mkdir -p /artifact/site /artifact/licenses/frontend \
    && cp -R "$THEME/dist"/. /artifact/site/ \
    && THEME="$THEME" APP_VERSION="$APP_VERSION" VCS_REF="$VCS_REF" FRONTEND_LOCKFILE=/build/web/bun.lock \
      generate-artifact-integrity /artifact

FROM scratch AS frontend-artifact

COPY --from=builder /artifact /

FROM nginxinc/nginx-unprivileged:1.27.5-alpine@sha256:65e3e85dbaed8ba248841d9d58a899b6197106c23cb0ff1a132b7bfe0547e4c0 AS frontend-runtime

COPY --from=frontend-artifact / /usr/share/nginx/artifact
COPY deploy/split/nginx /etc/nginx/templates
COPY --chmod=0555 deploy/split/scripts/verify-artifact.sh /usr/local/bin/verify-artifact.sh
COPY --chmod=0555 deploy/split/scripts/verify-release.sh /usr/local/bin/verify-release.sh
COPY --chmod=0555 deploy/split/scripts/render-release.sh /usr/local/bin/render-release.sh
COPY --chmod=0555 deploy/split/scripts/render-nginx.sh /usr/local/bin/render-nginx.sh
COPY --chmod=0555 deploy/split/scripts/frontend-entrypoint.sh /usr/local/bin/frontend-entrypoint

USER 101
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/frontend-entrypoint"]
CMD ["nginx", "-c", "/tmp/nginx/conf.d/nginx.conf", "-g", "daemon off;"]
