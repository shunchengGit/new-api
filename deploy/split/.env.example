# Build identity. Compose runtime images below must use immutable name@sha256:digest references.
APP_VERSION=v1.0.0-rc.21
VCS_REF=0123456789abcdef0123456789abcdef01234567
THEME=default
BACKEND_IMAGE=registry.example/new-api-backend@sha256:replace-with-64-hex-digest
FRONTEND_IMAGE=registry.example/new-api-frontend-default@sha256:replace-with-64-hex-digest
POSTGRES_IMAGE=postgres@sha256:replace-with-64-hex-digest
REDIS_IMAGE=redis@sha256:replace-with-64-hex-digest

PUBLIC_SCHEME=https
PUBLIC_HOST=api.example.com
PUBLIC_PORT=8080
BIND_ADDRESS=0.0.0.0

SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://api.example.com

POSTGRES_USER=newapi
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=newapi
REDIS_PASSWORD=replace-with-a-strong-redis-password
MAX_REQUEST_BODY_MB=128

GOOGLE_ANALYTICS_ID=
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=https://analytics.umami.is/script.js

# Set only after reviewing the documented login, registration, and binding impact.
ACKNOWLEDGE_LINUXDO_OAUTH_INCOMPATIBILITY=false

# ServerAddress, theme.frontend, and Passkey Origins/RP ID are database settings.
# ServerAddress and Passkey Origins must equal PUBLIC_SCHEME://PUBLIC_HOST.
# theme.frontend must equal THEME.
