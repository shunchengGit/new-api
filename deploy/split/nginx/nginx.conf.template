worker_processes auto;
pid /tmp/nginx/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    keepalive_timeout 65;
    client_max_body_size @CLIENT_MAX_BODY_SIZE@;
    client_body_temp_path /tmp/nginx/client_temp;
    proxy_temp_path /tmp/nginx/proxy_temp;
    fastcgi_temp_path /tmp/nginx/fastcgi_temp;
    uwsgi_temp_path /tmp/nginx/uwsgi_temp;
    scgi_temp_path /tmp/nginx/scgi_temp;

    # Do not enable gzip here: streaming relay responses must stay transparent.
    gzip off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' '';
    }

    resolver 127.0.0.11 valid=10s ipv6=off;
    upstream backend_upstream {
        zone backend_upstream 64k;
        server @BACKEND_SERVICE@ resolve;
        keepalive 32;
    }

    include /tmp/nginx/conf.d/real-ip.conf;

    server {
        listen @LISTEN_PORT@ default_server;
        server_name @PUBLIC_HOST@;
        root /usr/share/nginx/html;
        index index.html;

        # $host is normalized by nginx; all other Host values are rejected.
        if ($host != "@PUBLIC_HOST@") {
            return 444;
        }

        location = /assets {
            return 404;
        }

        location = /static {
            return 404;
        }

        location ^~ /assets/ {
            try_files $uri =404;
            expires 1y;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
        }

        location ^~ /static/ {
            try_files $uri =404;
            expires 1y;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
        }

        location = /index.html {
            try_files /index.html =404;
            expires -1;
            add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        }

        location = /build-info.json {
            try_files /build-info.json =404;
            expires -1;
            add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        }

        # Public files emitted at the web root are runtime/build metadata, not hashed assets.
        location ~ ^/[^/]+\.(?:ico|png|svg|webmanifest|json|txt|xml)$ {
            try_files $uri =404;
            expires -1;
            add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        }

        location = /api { include /tmp/nginx/conf.d/backend-proxy.inc; proxy_pass http://backend_upstream; }
        location ^~ /api/ { include /tmp/nginx/conf.d/backend-proxy.inc; proxy_pass http://backend_upstream; }
        location = /v1 { include /tmp/nginx/conf.d/backend-proxy.inc; proxy_pass http://backend_upstream; }
        location ^~ /v1/ { include /tmp/nginx/conf.d/backend-proxy.inc; proxy_pass http://backend_upstream; }
        location = /v1beta { include /tmp/nginx/conf.d/backend-proxy.inc; proxy_pass http://backend_upstream; }
        location ^~ /v1beta/ { include /tmp/nginx/conf.d/backend-proxy.inc; proxy_pass http://backend_upstream; }
        location = /pg { include /tmp/nginx/conf.d/backend-proxy.inc; proxy_pass http://backend_upstream; }
        location ^~ /pg/ { include /tmp/nginx/conf.d/backend-proxy.inc; proxy_pass http://backend_upstream; }
        location = /mj { include /tmp/nginx/conf.d/backend-proxy.inc; proxy_pass http://backend_upstream; }
        location ^~ /mj/ { include /tmp/nginx/conf.d/backend-proxy.inc; proxy_pass http://backend_upstream; }
        location = /suno { include /tmp/nginx/conf.d/backend-proxy.inc; proxy_pass http://backend_upstream; }
        location ^~ /suno/ { include /tmp/nginx/conf.d/backend-proxy.inc; proxy_pass http://backend_upstream; }
        location = /kling { include /tmp/nginx/conf.d/backend-proxy.inc; proxy_pass http://backend_upstream; }
        location ^~ /kling/ { include /tmp/nginx/conf.d/backend-proxy.inc; proxy_pass http://backend_upstream; }
        location = /jimeng { include /tmp/nginx/conf.d/backend-proxy.inc; proxy_pass http://backend_upstream; }
        location ^~ /jimeng/ { include /tmp/nginx/conf.d/backend-proxy.inc; proxy_pass http://backend_upstream; }

        # Only these dashboard billing endpoints are exposed, with an optional trailing slash.
        location ~ ^/(?:v1/)?dashboard/billing/(?:subscription|usage)/?$ {
            include /tmp/nginx/conf.d/backend-proxy.inc;
            proxy_pass http://backend_upstream;
        }

        # Mode-prefixed MJ traffic has exactly one mode segment and an approved action root.
        location ~ ^/[^/]+/mj/(?:image|submit|task|insight-face)(?:/|$) {
            include /tmp/nginx/conf.d/backend-proxy.inc;
            proxy_pass http://backend_upstream;
        }

        # The runtime-rendered index supports client-side SPA routes.
        location / {
            try_files $uri $uri/ /index.html =404;
            expires -1;
            add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        }
    }
}
